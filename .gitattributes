# Detecta automaticamente arquivos de texto.
* text=auto
# Código, documentação e configurações.
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.c         text eol=lf
*.h         text eol=lf
*.cc        text eol=lf
*.cpp       text eol=lf
*.cxx       text eol=lf
*.hpp       text eol=lf
*.java      text eol=lf
*.py        text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf
Makefile    text eol=lf
# Scripts exclusivos do Windows.
*.ps1       text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
# Linguagem detectada pelo GitHub: os slides em HTML do trabalho de AEDs III sao
# material de apresentacao, nao codigo da aplicacao. Sem isto o repositorio
# aparece como HTML, escondendo o Java e o C++ que sao o conteudo real.
3-periodo/dce797-aeds3/trabalhos/slides_codigo_fonte/*.html linguist-documentation

# Arquivos binários.
*.png filter=lfs diff=lfs merge=lfs -text lockable
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.jar       binary
*.zip       binary
*.7z        binary
*.rar       binary
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
