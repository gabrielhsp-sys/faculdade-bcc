root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml,html,css,js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

[*.{c,h,cc,cpp,cxx,hpp,java,py,sh,ps1,sql}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
indent_style = space
indent_size = 4
